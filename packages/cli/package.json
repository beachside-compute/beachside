{
  "name": "@beachside/cli",
  "version": "0.19.0",
  "private": false,
  "type": "module",
  "description": "Agent-first command line for creating and managing Beachside sandboxes.",
  "bin": {
    "beachside": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "bun run credential-client:build && tsc -p tsconfig.json",
    "build": "bun run credential-client:build && rm -rf dist && bun build src/main.ts --target node --format esm --outdir dist --external beachside --external @beachside/adapter --external zod",
    "credential-client:build": "test ! -f node_modules/@beachside/credential-client/tsconfig.build.json || tsc -p node_modules/@beachside/credential-client/tsconfig.build.json --typeRoots ../../node_modules/@types --types bun"
  },
  "dependencies": {
    "@beachside/adapter": "workspace:*",
    "beachside": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@beachside/boat": "workspace:*",
    "@beachside/boxd": "workspace:*",
    "@beachside/daytona": "workspace:*",
    "@beachside/e2b": "workspace:*",
    "@beachside/runloop": "workspace:*",
    "@beachside/freestyle": "workspace:*",
    "@beachside/archil": "workspace:*",
    "@beachside/exe-dev": "workspace:*",
    "@beachside/modal": "workspace:*",
    "@beachside/vercel": "workspace:*",
    "@beachside-internal/provider-fake": "workspace:*",
    "@clack/prompts": "1.9.0",
    "@beachside/credential-client": "github:beachside-compute/credential-broker#9f28ce81f1cce424b22d218d83ff0ab2229b8546"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beachside-compute/beachside.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/beachside-compute/beachside/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
