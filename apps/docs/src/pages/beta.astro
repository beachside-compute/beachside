<script>
  // The site worker (apps/docs/worker) saves signups to Resend; it answers { ok, message? }.
  const signupEndpoint = "/api/beta-signup";

  const query = new URLSearchParams(location.search);

  // Tag each signup with where it came from, e.g. "beachside.run/beta reddit rex".
  const source = ["beachside.run/beta", query.get("utm_source"), query.get("utm_campaign")]
    .filter(Boolean)
    .join(" ");

  type Reply = { saved: boolean; message: string };

  // Parse the worker's reply at the boundary: { ok: true } or { ok: false, message }.
  async function parseReply(response: Response): Promise<Reply> {
    const body: { ok?: boolean; message?: string } = await response.json().catch(() => ({}));

    if (response.ok && body.ok === true) return { saved: true, message: "" };

    if (response.status === 429)
      return { saved: false, message: "Too many signups from your network just now. Try again in a minute." };

    return { saved: false, message: body.message || "Something went wrong. Please try again." };
  }

  for (const form of document.querySelectorAll<HTMLFormElement>(".signup-form")) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const input = form.querySelector<HTMLInputElement>("input[name=email]");

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");

      const fields = form.querySelector<HTMLElement>(".signup-fields");

      const status = form.querySelector<HTMLElement>(".signup-status");

      if (!input || !button || !fields || !status) return;

      const email = input.value.trim();

      button.disabled = true;
      status.hidden = true;

      try {
        const website = form.querySelector<HTMLInputElement>("input[name=website]")?.value ?? "";

        const response = await fetch(signupEndpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, source, website }),
        });

        const reply = await parseReply(response);

        if (reply.saved) {
          fields.hidden = true;
          status.textContent = `Your spot in the 1.0 beta is saved for ${email}.`;
          status.dataset.state = "done";
        } else {
          status.textContent = reply.message;
          status.dataset.state = "error";
        }
      } catch {
        status.textContent = "Something went wrong. Please try again.";
        status.dataset.state = "error";
      }

      status.hidden = false;
      button.disabled = false;
    });
  }

  // Terminal tabs: pick Rex or Herdr and boxd or Freestyle; one rendered session shows at a time.
  const picked = { server: "rex", provider: "boxd" };

  const labels = new Map([
    ["boxd", "boxd"],
    ["freestyle", "Freestyle"],
  ]);

  function showSession() {
    for (const pre of document.querySelectorAll<HTMLElement>(".term-session"))
      pre.hidden = pre.dataset.server !== picked.server || pre.dataset.provider !== picked.provider;

    for (const tab of document.querySelectorAll<HTMLButtonElement>("[data-pick]")) {
      const key = tab.dataset.pick === "server" ? "server" : "provider";

      tab.setAttribute("aria-pressed", String(picked[key] === tab.dataset.value));
    }

    const via = document.querySelector(".term-provider");

    if (via) via.textContent = labels.get(picked.provider) ?? picked.provider;
  }

  for (const tab of document.querySelectorAll<HTMLButtonElement>("[data-pick]")) {
    tab.addEventListener("click", () => {
      const key = tab.dataset.pick === "server" ? "server" : "provider";

      picked[key] = tab.dataset.value ?? picked[key];
      showSession();
    });
  }

  showSession();
</script>
</body>
</html>
