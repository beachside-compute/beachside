{
  "name": "@beachside-internal/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "credential-client:build": "tsc -p node_modules/@beachside/credential-client/tsconfig.build.json --typeRoots ../../node_modules/@types --types bun",
    "site:check": "bun run credential-client:build && astro check && bun scripts/check-skills.mjs && bun scripts/check-links.mjs && bun run site:build",
    "dev": "astro dev",
    "check": "bun run credential-client:build && astro check && bun scripts/check-observability-snippets.mjs && bun scripts/check-skills.mjs && tsc -p examples/tsconfig.json && bun scripts/check-links.mjs && bun run typescript:check && bun run cli:check",
    "site:build": "astro build && bun scripts/check-dist.mjs",
    "build": "bun run provider:check && bun run site:build",
    "provider:check": "bun ../../packages/sdk-qualification/provider-qualification/render.ts --check",
    "examples:test": "bun test examples",
    "preview": "astro preview",
    "typescript:generate": "bun run credential-client:build && bun scripts/generate-typescript-reference.mjs",
    "typescript:check": "bun scripts/generate-typescript-reference.mjs --check",
    "cli:generate": "bun scripts/generate-cli-reference.mjs",
    "cli:check": "bun scripts/generate-cli-reference.mjs --check",
    "analytics:test": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "astro": "7.4.7",
    "posthog-js": "^1.448.0"
  },
  "devDependencies": {
    "@beachside/credential-client": "github:beachside-compute/credential-broker#0a09e9d2dd32aa348cf112c4d9d90429d5c3a97a",
    "@astrojs/check": "0.9.6",
    "beachside": "workspace:*",
    "@beachside-internal/provider-fake": "workspace:*",
    "typescript": "5.9.3",
    "wrangler": "4.141.0",
    "@beachside/adapter": "workspace:*",
    "zod": "4.6.6",
    "@beachside/modal": "workspace:*",
    "satteri": "0.10.5",
    "@beachside/daytona": "workspace:*",
    "@beachside/e2b": "workspace:*",
    "@beachside/boxd": "workspace:*",
    "@beachside/boat": "workspace:*",
    "@beachside/runloop": "workspace:*",
    "@beachside/freestyle": "workspace:*",
    "@beachside/archil": "workspace:*",
    "@beachside/exe-dev": "workspace:*",
    "@beachside/vercel": "workspace:*",
    "@playwright/test": "1.65.0"
  }
}
